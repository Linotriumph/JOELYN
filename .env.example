# JOELYN Background Job System Configuration

# Server Port
PORT=3000

# Database & Storage
DATABASE_PATH=./data/joelyn.db
STORAGE_DIR=./storage/reports

# Worker Concurrency limit (Max jobs a single worker processes simultaneously)
WORKER_CONCURRENCY=5

# Maximum retry attempts before moving job to DEAD
MAX_JOB_ATTEMPTS=3

# Retry Backoff Settings (in milliseconds)
RETRY_BASE_DELAY_MS=2000
RETRY_MAX_DELAY_MS=30000
RETRY_JITTER_RATIO=0.25

# Processing Timeout (in milliseconds, for stuck job recovery)
# Jobs stuck in 'processing' longer than this are recovered
PROCESSING_TIMEOUT_MS=15000

# Worker Polling & Recovery Scan intervals (in milliseconds)
POLL_INTERVAL_MS=500
RECOVERY_INTERVAL_MS=5000
